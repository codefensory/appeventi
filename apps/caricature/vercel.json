{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/generate.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/index.html"
    }
  ]
}
